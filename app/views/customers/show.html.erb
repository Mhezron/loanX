<div class="max-w-lg mx-auto bg-white shadow-md rounded-lg p-6">
  <h2 class="text-2xl font-semibold text-gray-800 mb-4">Customer Details</h2>

  <div class="mb-4">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">
      <%= @customer.first_name %> <%= @customer.last_name %>
    </h1>
    <p class="text-gray-700">ID Number: <%= @customer.id_number %></p>
    <p class="text-gray-700">Phone Number: <%= @customer.phone_number %></p>
    <p class="text-gray-700">Date of Birth: <%= @customer.dob %></p>
  </div>

  <h2 class="text-2xl font-semibold text-gray-800 mb-4">Loan Details</h2>
  <% @customer.loans.each do |loan| %>
    <div class="mb-6 p-4 border border-gray-200 rounded">
      <p class="text-gray-700"><strong>Loan Amount:</strong> <%= loan.loan_amount %></p>
      <p class="text-gray-700"><strong>Interest:</strong> 20% </p>
      <p class="text-gray-700"><strong>Repayment Date:</strong> <%= loan.repayment_date %></p>
      <p class="text-gray-700"><strong>Repayment Amount:</strong> <%= loan.repayment_amount %></p>

  <h2 class="text-2xl font-semibold text-gray-800 mb-4">Phone Details</h2>
      <% if loan.phone %>
        <div class="mt-4">
          <h4 class="text-lg font-semibold text-gray-800">Collateral Phone</h4>
          <p class="text-gray-700">Make: <%= loan.phone.phone_make %></p>
          <p class="text-gray-700">Model: <%= loan.phone.phone_model %></p>
          <p class="text-gray-700">Code: <%= loan.phone.code %></p>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center justify-between mt-6">
    <%= link_to "Back", customers_path, class: "text-blue-500 hover:text-blue-700 font-medium" %>
    <%= link_to "Edit", edit_customer_path(@customer), class: "text-blue-500 hover:text-blue-700 font-medium" %>
    <%= button_to "Delete", customer_path(@customer), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
  </div>
</div>


